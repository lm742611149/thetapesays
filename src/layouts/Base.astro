---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';
import Motion from '../components/Motion.astro';
import Loader from '../components/Loader.astro';
import Backdrop from '../components/Backdrop.astro';
import Live from '../components/Live.astro';
import NewsTicker from '../components/NewsTicker.astro';
import CoinModal from '../components/CoinModal.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: string;
	noindex?: boolean;
	keywords?: string[];
	schema?: Record<string, any>;
}
const { title, description, image, type, noindex, keywords, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} type={type}
			noindex={noindex} keywords={keywords} schema={schema} />
	</head>
	<body>
		<Loader />
		<Backdrop />
		<div class="topbar">
			<Ticker />
			<Header />
		</div>
		<main>
			<slot />
		</main>
		<Footer />
		<Motion />
		<Live />
		<NewsTicker />
		<CoinModal />
	<script>
			import { initTracking } from '../lib/track';
			initTracking();

			/**
			 * A fresh navigation should start at the top. The browser restores the
			 * previous scroll offset for a URL it has seen before, which on a nav
			 * click reads as "the new page opened halfway down". Back and forward
			 * still restore, because those are the ones people expect to.
			 */
			const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
			if (nav?.type === 'navigate' && !location.hash && scrollY > 0) {
				// instant, not smooth — global scroll-behavior would animate it
				window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
			}
		</script>
	</body>
</html>

<style is:global>
	/* Quote strip and nav travel together and stay pinned. */
	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
	}
	/* Room for the fixed headline crawl at the bottom. */
	body { padding-bottom: var(--newsbar, 36px); }
	@media (max-width: 620px) { body { padding-bottom: var(--newsbar, 32px); } }
</style>
