---
/**
 * The trade log, compressed to a panel.
 *
 * Reads the same generated file /positions does, so it can never drift from
 * the full page — there is no second copy of these numbers to update. The
 * sparkline is the same cumulative curve at panel scale: enough to show the
 * shape and the one drawdown, not enough to pretend it's the real chart.
 */
import log from '../data/trades.json';

const { stats, curve, verified, since, through } = log as any;

const money = (v: number) => `${v >= 0 ? '+' : '−'}$${Math.abs(v).toFixed(2)}`;
const pc = (v: number) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(2)}%`;

// tiny cumulative curve — same data as the page, drawn at a glance
const W = 300, H = 56, PAD = 3;
const cums = curve.map((p: any) => p.cum);
const lo = Math.min(0, ...cums), hi = Math.max(0, ...cums);
const X = (i: number) => (i / Math.max(1, curve.length - 1)) * W;
const Y = (v: number) => PAD + (1 - (v - lo) / (hi - lo || 1)) * (H - PAD * 2);
const line = curve
	.map((p: any, i: number) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(p.cum).toFixed(1)}`)
	.join(' ');
const zero = Y(0);
const area = `${line} L ${W} ${zero.toFixed(1)} L 0 ${zero.toFixed(1)} Z`;
---

{verified && (
	<a class="tr" href="/positions/" data-track="track-record">
		<div class="head">
			<div>
				<i class="label">Net realised · {since} → {through}</i>
				<b class={stats.netPnl >= 0 ? 'up' : 'down'}>{money(stats.netPnl)}</b>
			</div>
			<span class="go">the full log →</span>
		</div>

		<svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
			<defs>
				{/* every other chart here fades its fill out; a flat one reads as a
				    block sitting on top of the panel rather than as the area under
				    a curve */}
				<linearGradient id="tr-fill" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0%" stop-color="var(--accent)" stop-opacity="0.24" />
					<stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
				</linearGradient>
			</defs>
			<line class="z" x1="0" y1={zero.toFixed(1)} x2={W} y2={zero.toFixed(1)} />
			<path class="fill" d={area} />
			<path class="ln" d={line} />
		</svg>

		<dl class="kpi">
			<div><dt>Trades</dt><dd>{stats.trades}</dd></div>
			<div><dt>Win rate</dt><dd>{stats.winRate}%</dd></div>
			<div><dt>Profit factor</dt><dd>{stats.profitFactor}</dd></div>
			<div><dt>Avg win / loss</dt><dd class="wl">
				<span class="up">{pc(stats.avgWin)}</span><span class="sl">/</span><span class="down">{pc(stats.avgLoss)}</span>
			</dd></div>
		</dl>

		<p class="fine">
			Every fill from the exchange record, including the {stats.losses} that lost.
		</p>
	</a>
)}

<style>
	.tr {
		display: block;
		text-decoration: none;
		color: inherit;
		border-radius: var(--radius);
		transition: background 0.16s;
	}
	.tr:hover { background: rgba(255, 255, 255, 0.014); }
	.tr:hover .go { color: var(--accent); }

	.head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
	.head i { font-size: 0.6rem; display: block; margin-bottom: 4px; }
	.head b {
		font-family: var(--font-mono), monospace; font-size: 2rem; font-weight: 700;
		line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
	}
	.go {
		font-family: var(--font-mono), monospace; font-size: 0.64rem;
		text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-mute);
		white-space: nowrap; transition: color 0.16s;
	}

	.spark { width: 100%; height: 56px; display: block; margin: 14px 0 4px; overflow: visible; }
	.z { stroke: var(--line-bright); stroke-width: 1; }
	.fill { fill: url(#tr-fill); }
	.ln {
		fill: none; stroke: var(--accent); stroke-width: 1.8;
		stroke-linejoin: round; stroke-linecap: round;
		/* the viewBox is stretched horizontally; this keeps the stroke even */
		vector-effect: non-scaling-stroke;
	}

	.kpi {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 10px; margin: 12px 0 0;
		padding-top: 12px; border-top: 1px solid var(--line);
	}
	.kpi div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
	.kpi dt {
		font-family: var(--font-mono), monospace; font-size: 0.58rem;
		text-transform: uppercase; letter-spacing: 0.09em; color: var(--fg-mute);
	}
	.kpi dd {
		margin: 0; font-family: var(--font-mono), monospace; font-size: 1.02rem;
		font-weight: 700; color: #fff; font-variant-numeric: tabular-nums; line-height: 1.1;
	}
	.wl { display: flex; align-items: baseline; gap: 3px; font-size: 0.86rem; }
	.sl { color: var(--fg-mute); font-weight: 400; }

	.fine {
		margin: 11px 0 0; font-family: var(--font-mono), monospace;
		font-size: 0.63rem; color: var(--fg-mute);
	}

	@media (max-width: 560px) {
		.kpi { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 10px; }
		.head b { font-size: 1.7rem; }
	}
</style>
