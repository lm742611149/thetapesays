---
/**
 * The one referral placement on the site.
 *
 * It replaces the slots that sat inside the content on nine pages. Those
 * interrupted the reading and, measured over a week, were clicked once — by me.
 * A permanent bar below the content costs no attention mid-article and is on
 * every page instead of some of them.
 *
 * Yellow, and loud. I built the restrained version first — dark bar, yellow
 * edge — and it disappeared into a dark site, which is the one thing a bar
 * whose whole job is to be seen cannot do. It is one strip at the bottom of
 * the page, below everything, so it can afford to be the brightest thing on
 * screen without touching the reading above it.
 */
import { REFERRAL } from '../consts';

const live = REFERRAL?.live && REFERRAL.href && REFERRAL.code;
---

{live && (
	<aside class="refbar" data-refbar>
		<div class="in">
			<span class="mark" aria-hidden="true"></span>

			<span class="who">{REFERRAL.name}</span>

			<span class="pitch">Automatic. Up to 50% back on every trading fee.</span>

			{/* phones drop the code chip — the link already carries it — so the
			    space goes to a line that says what the button is for */}
			<span class="pitchm">Automatic. Up to 50% back.</span>

			<span class="code" data-refcode={REFERRAL.code} title="Copy the code">
				<i class="cl">Code</i>
				<b>{REFERRAL.code}</b>
				<span class="cp" data-refcopy>copy</span>
			</span>

			<a class="cta" href={REFERRAL.href} rel="sponsored noopener" target="_blank" data-ref-cta>
				<span class="long">Open an account</span>
				<span class="short">Sign up</span>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</a>
		</div>
	</aside>
)}

<style>
	.refbar {
		position: fixed;
		left: 0;
		right: 0;
		bottom: var(--newsbar, 36px);
		height: var(--refbar, 58px);
		z-index: 40;
		background: linear-gradient(100deg, #f0b90b 0%, #ffcf3d 46%, #f0b90b 100%);
		box-shadow: 0 -10px 30px rgba(240, 185, 11, 0.16), 0 -1px 0 rgba(255, 255, 255, 0.22) inset;
		color: #120d02;
	}
	/**
	 * Full-bleed on purpose: the bar has the whole width, so the parts spread to
	 * the edges rather than huddling in a centred column. Identity left, offer
	 * in the middle, the two things you act on at the right.
	 */
	.in {
		height: 100%;
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 0 18px;
		min-width: 0;
		flex-wrap: nowrap;
	}
	.mark {
		width: 8px; height: 8px; border-radius: 50%; flex: none;
		background: #120d02;
		animation: refpulse 2.4s ease-in-out infinite;
	}
	@keyframes refpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
	@media (prefers-reduced-motion: reduce) { .mark { animation: none; } }
	.who {
		font-family: var(--font-mono), monospace;
		font-size: 0.74rem; letter-spacing: 0.13em; text-transform: uppercase;
		color: #120d02; font-weight: 700; white-space: nowrap; flex: none;
	}
	.pitch {
		font-size: 0.88rem; color: #2a1f02; font-weight: 500; line-height: 1.3;
		min-width: 0; flex: 1 1 auto;
	}
	.pitchm { display: none; }
	.code {
		display: inline-flex; align-items: baseline; gap: 8px; flex: none;
		padding: 6px 12px; border-radius: 8px; cursor: pointer;
		border: 1px dashed rgba(18, 13, 2, 0.45);
		background: rgba(18, 13, 2, 0.08);
	}
	.code:hover { background: rgba(18, 13, 2, 0.16); }
	.cl {
		font-style: normal; font-family: var(--font-mono), monospace;
		font-size: 0.62rem; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(18, 13, 2, 0.62);
	}
	.code b {
		font-family: var(--font-mono), monospace; font-size: 0.9rem;
		font-weight: 700; color: #120d02; letter-spacing: 0.05em;
	}
	.cp {
		font-family: var(--font-mono), monospace; font-size: 0.62rem;
		letter-spacing: 0.08em; text-transform: uppercase; color: rgba(18, 13, 2, 0.62);
	}
	.cta {
		display: inline-flex; align-items: center; gap: 7px; flex: none;
		margin-left: auto;
		background: #120d02; color: #ffd24a;
		font-weight: 700; font-size: 0.87rem; letter-spacing: -0.01em;
		padding: 10px 16px; border-radius: 9px; text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
		box-shadow: 0 2px 0 rgba(18, 13, 2, 0.25);
	}
	.cta:hover { transform: translateY(-1px); box-shadow: 0 4px 10px rgba(18, 13, 2, 0.3); }
	.cta .short { display: none; }
	.cta svg {
		width: 15px; height: 15px; fill: none; stroke: currentColor;
		stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
	}

	/**
	 * The code chip goes before the sentence does. It was the other way round,
	 * which left a middle width showing a bare code with nothing saying what it
	 * was for — and with the sentence gone there was nothing to fill the middle,
	 * so everything huddled at the left edge. The link carries the code anyway;
	 * the sentence is the only part that makes anyone want it.
	 */
	@media (max-width: 1100px) {
		.code { display: none; }
	}
	/**
	 * A fixed bar's overflow does not show up in scrollWidth, so it will happily
	 * push its own contents off-screen without the page looking broken. At 390px
	 * the full label plus the code plus the padding does not fit, so the label
	 * shortens and the code is allowed to shrink rather than holding its width
	 * and shoving the button out.
	 */
	/**
	 * Phones get the offer and the button, nothing else. The code chip goes —
	 * the referral link already carries the code, so asking someone to copy it
	 * on a phone is a step that buys nothing — and the width it was taking goes
	 * to a line that says what the button does.
	 */
	@media (max-width: 560px) {
		.refbar { height: var(--refbar, 54px); }
		.in { gap: 10px; padding: 0 13px; }
		.who, .code, .pitch { display: none; }
		/**
		 * flex-basis 0, not auto. With auto the line claims its content width
		 * first and the button — which must not shrink — gets pushed past the
		 * right edge, where a fixed bar hides it with no scrollbar to hint that
		 * anything is missing. From zero the line only ever gets what is left.
		 */
		.pitchm {
			display: block; flex: 1 1 0; min-width: 0;
			font-size: 0.88rem; font-weight: 600; color: #120d02; line-height: 1.25;
			white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
		}
		.cta { flex: 0 0 auto; padding: 9px 14px; font-size: 0.85rem; gap: 6px; }
		.cta .long { display: none; }
		.cta .short { display: inline; }
	}
</style>

<script>
	for (const el of document.querySelectorAll<HTMLElement>('[data-refcode]')) {
		el.addEventListener('click', async () => {
			const code = el.dataset.refcode!;
			try {
				await navigator.clipboard.writeText(code);
			} catch {
				// clipboard is blocked without a secure context or permission;
				// selecting the text at least leaves it one keystroke away
				const r = document.createRange();
				r.selectNodeContents(el.querySelector('b')!);
				const sel = getSelection();
				sel?.removeAllRanges();
				sel?.addRange(r);
				return;
			}
			const tag = el.querySelector<HTMLElement>('[data-refcopy]');
			if (!tag) return;
			const was = tag.textContent;
			tag.textContent = 'copied';
			setTimeout(() => { tag.textContent = was; }, 1400);
		});
	}
</script>
