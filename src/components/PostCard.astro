---
import { KIND_LABEL, type Post } from '../lib/posts';
interface Props {
	post: Post;
	featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, description, pubDate, kind, stat, statLabel, tags } = post.data;
const d = pubDate.toISOString().slice(0, 10);
---

<article class={`card ${featured ? 'feat' : ''}`}>
	<a href={`/research/${post.id}/`} class="hit" aria-label={title}></a>
	<div class="meta">
		<span class="label kind" data-kind={kind}>{KIND_LABEL[kind]}</span>
		<time class="label" datetime={d}>{d}</time>
	</div>
	<h3>{title}</h3>
	<p>{description}</p>
	{
		stat && (
			<div class="stat">
				<span class="num">{stat}</span>
				{statLabel && <span class="slabel">{statLabel}</span>}
			</div>
		)
	}
	{
		tags.length > 0 && (
			<div class="tags">
				{tags.slice(0, 3).map((t) => (
					<span class="tag">{t}</span>
				))}
			</div>
		)
	}
</article>

<style>
	.card {
		position: relative;
		background: var(--bg-panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 20px 22px 22px;
		transition: border-color 0.16s ease, background 0.16s ease, transform 0.16s ease;
		display: flex;
		flex-direction: column;
	}
	.card:hover {
		border-color: var(--line-bright);
		background: var(--bg-hover);
		transform: translateY(-2px);
	}
	.hit {
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--radius);
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 14px;
	}
	.kind {
		color: var(--accent);
	}
	.kind[data-kind='log'] {
		color: var(--up);
	}
	.meta time {
		margin-left: auto;
		color: #4f5766;
	}
	/* the finding sits under the piece it came from: a card is read to decide
	   what to open, and "0.29x vs 7.90x" answers nothing until you know what
	   was compared */
	.stat {
		margin-top: 12px;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	/**
	 * The finding used to be set at 1.75rem in white against a 1.06rem title,
	 * so the card led with a number and whispered what the piece was about. A
	 * list exists to help someone choose what to read, and the title is what
	 * answers that; the figure is the hook, and a hook works by colour here
	 * rather than by out-sizing the thing it is hooking for. Matches the share
	 * card, where the headline is the largest type and the figure sits under it.
	 */
	.num {
		font-family: var(--font-mono), monospace;
		font-size: 1.12rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		/* the same yellow, lightened — it belongs to the title above it and must
		   not compete with it */
		color: color-mix(in srgb, var(--accent) 58%, #f3f5f8);
		line-height: 1.1;
	}
	.feat .num {
		font-size: 1.28rem;
	}
	.slabel {
		font-family: var(--font-mono), monospace;
		font-size: 0.76rem;
		color: var(--fg-mute);
	}
	h3 {
		font-size: 1.34rem;
		font-weight: 650;
		letter-spacing: -0.017em;
		margin: 0 0 8px;
		line-height: 1.25;
		color: var(--accent);
	}
	.feat h3 {
		font-size: 1.72rem;
		letter-spacing: -0.024em;
	}
	/* the title is already the accent, so hover has to move the other way */
	.card:hover h3 {
		color: #fff;
	}
	p {
		margin: 0;
		font-size: 0.93rem;
		color: var(--fg-dim);
		line-height: 1.6;
	}
	.tags {
		display: flex;
		gap: 6px;
		margin-top: 16px;
		flex-wrap: wrap;
	}
	.tag {
		font-family: var(--font-mono), monospace;
		font-size: 0.64rem;
		color: var(--fg-mute);
		border: 1px solid var(--line);
		border-radius: 3px;
		padding: 2px 6px;
	}
</style>
