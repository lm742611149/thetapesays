---
/**
 * The long explanation, moved off the panel and onto its heading.
 *
 * These notes are reference material — read once, then never again by the same
 * person. Left in the layout they take four lines at half the panel's width and
 * push the next table down; on a heading they cost nothing until wanted.
 *
 * CSS-driven rather than scripted so it works before hydration and on a
 * keyboard: hover, focus, and tap all open it. Placement flips to the left near
 * the right edge via `align="end"`, since a tooltip is no use off-screen.
 */
interface Props {
	/** Flip the panel leftwards — use on anything near the right edge. */
	align?: 'start' | 'end';
	/** Accessible name; defaults to a generic one. */
	label?: string;
}
const { align = 'start', label = 'What this means' } = Astro.props;
---

<span class={`ex ${align}`} tabindex="0" role="button" aria-label={label}>
	<svg viewBox="0 0 16 16" aria-hidden="true">
		<circle cx="8" cy="8" r="6.6" />
		<path d="M8 7.2v4" />
		<circle class="dot" cx="8" cy="4.9" r="0.85" />
	</svg>
	<span class="pop" role="tooltip"><slot /></span>
</span>

<style>
	.ex {
		position: relative;
		display: inline-grid;
		place-items: center;
		width: 16px;
		height: 16px;
		margin-left: 6px;
		vertical-align: -2px;
		cursor: help;
		color: var(--fg-mute);
		transition: color 0.14s;
	}
	.ex:hover, .ex:focus-visible { color: var(--accent); outline: none; }

	.ex svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
	}
	.ex .dot { fill: currentColor; stroke: none; }

	.pop {
		position: absolute;
		top: calc(100% + 9px);
		left: -10px;
		z-index: 40;
		width: max-content;
		max-width: min(46ch, 78vw);
		padding: 11px 13px;
		border: 1px solid var(--line-bright);
		border-radius: 9px;
		background: #0b0e13;
		box-shadow: 0 14px 34px rgba(0, 0, 0, 0.6);
		font-family: var(--font-body), system-ui, sans-serif;
		font-size: 0.79rem;
		font-weight: 400;
		line-height: 1.62;
		letter-spacing: 0;
		text-transform: none;
		color: var(--fg-dim);
		text-align: left;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-3px);
		transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
	}
	.ex.end .pop { left: auto; right: -10px; }

	.pop :global(b) { color: #fff; font-weight: 700; }
	.pop :global(em) { color: var(--accent); font-style: normal; }

	.ex:hover .pop,
	.ex:focus .pop,
	.ex:focus-within .pop {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	/* pointing notch */
	.pop::before {
		content: '';
		position: absolute;
		bottom: 100%;
		left: 14px;
		border: 6px solid transparent;
		border-bottom-color: var(--line-bright);
	}
	.ex.end .pop::before { left: auto; right: 14px; }

	@media (max-width: 560px) {
		/* anchored to the viewport instead, so a narrow screen can't clip it */
		.pop { position: fixed; left: 12px; right: 12px; top: auto; max-width: none; width: auto; }
		.ex.end .pop { left: 12px; right: 12px; }
		.pop::before { display: none; }
	}
	@media (prefers-reduced-motion: reduce) {
		.pop { transition: none; }
	}
</style>

<script>
	/**
	 * On a phone the panel is fixed, so it needs a top in viewport coordinates —
	 * and a tap outside has to close it, since there is no pointerleave.
	 */
	const narrow = matchMedia('(max-width: 560px)');
	for (const ex of document.querySelectorAll<HTMLElement>('.ex')) {
		const pop = ex.querySelector<HTMLElement>('.pop');
		if (!pop) continue;
		ex.addEventListener('focus', () => {
			if (!narrow.matches) return (pop.style.top = '');
			const r = ex.getBoundingClientRect();
			pop.style.top = `${Math.min(r.bottom + 9, innerHeight - 160)}px`;
		});
	}
	document.addEventListener('pointerdown', (e) => {
		const open = document.activeElement as HTMLElement | null;
		if (open?.classList.contains('ex') && !open.contains(e.target as Node)) open.blur();
	});
</script>
