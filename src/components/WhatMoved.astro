---
/**
 * The difference row.
 *
 * Every other panel on this page reports a level. A level answers "where are
 * we", which a reader asks once; this answers "what happened since yesterday",
 * which is the question that brings them back.
 *
 * A metric with no baseline yet prints its level and a dash. The rolling record
 * started on 2026-09-18, so most of these fill in over the first day — writing
 * a zero in the meantime would be inventing the one thing the panel exists to
 * report.
 */
import moved from '../data/moved.json';

const rows: any[] = moved?.rows ?? [];
const withDelta = rows.filter((r) => r.delta !== undefined).length;

const level = (v: number, fmt: string) =>
	fmt === 'usd0' ? `$${Math.round(v).toLocaleString('en-US')}`
	: fmt === 'usdB' ? `$${v.toFixed(1)}B`
	: fmt === 'eh' ? `${Math.round(v)} EH/s`
	: fmt === 'pct1' ? `${v.toFixed(1)}%`
	: fmt === 'pct2' ? `${v.toFixed(2)}%`
	: fmt === 'x2' ? `${v.toFixed(2)}x`
	: fmt === 'n3' ? v.toFixed(3)
	: Math.round(v).toString();

/** Percent for anything that compounds, points for things already in percent. */
const delta = (r: any) =>
	r.fmt === 'pct1' || r.fmt === 'pct2' || r.fmt === 'n0'
		? `${r.delta >= 0 ? '+' : ''}${r.delta.toFixed(r.dp)}${r.fmt === 'n0' ? '' : 'pp'}`
		: `${r.pct >= 0 ? '+' : ''}${r.pct.toFixed(r.dp)}%`;

const since = moved?.since
	? new Date(moved.since).toISOString().slice(0, 16).replace('T', ' ') + ' UTC'
	: null;
---

{rows.length > 0 && (
	<section class="panel moved" data-reveal>
		<div class="bh">
			<h3>What moved</h3>
			<span class="legend">
				{withDelta === rows.length ? 'against 24h ago' : `${withDelta} of ${rows.length} have a 24h baseline`}
			</span>
		</div>
		<div class="grid">
			{rows.map((r) => (
				<div class:list={['cell', { hot: r.notable }]}>
					<i class="label">{r.label}</i>
					<b class="mono">{level(r.value, r.fmt)}</b>
					{r.delta === undefined ? (
						<em class="none" title="no reading from 24h ago yet">—</em>
					) : (
						<em class={r.delta > 0 ? 'u' : r.delta < 0 ? 'd' : ''}>
							{delta(r)}
							{r.notable && <span class="flag" title="a 2-sigma move against its own last 30 days">·2σ</span>}
						</em>
					)}
					<div class="track" title={r.scale?.note ?? 'no published range for this one yet'}>
						{r.pos !== undefined && (
							<>
								<span class="fill" style={`width:${(r.pos * 100).toFixed(1)}%`} />
								<span class="pin" style={`left:${(r.pos * 100).toFixed(1)}%`} />
								{(r.scale?.marks ?? []).map((mk: number) => (
									<i
										class="mk"
										style={`left:${(((mk - r.scale.min) / (r.scale.max - r.scale.min)) * 100).toFixed(1)}%`}
									/>
								))}
							</>
						)}
					</div>
				</div>
			))}
		</div>
		<p class="fine">
			{since
				? `Measured against the reading from ${since}. Tracks show where each level sits on its published range.`
				: 'Baselines fill in as the record builds; a dash means no reading from 24h ago yet. Tracks show where each level sits on its published range.'}
		</p>
	</section>
)}

<style>
	/* .panel is global; the padding that makes it a "block" lives in index.astro's
	   scoped styles and cannot reach in here, so it is restated to match. */
	/* the stat row above sets no bottom margin of its own, so this panel carries
	   both sides of the gap; 14px is what every other block on the page uses */
	.moved { padding: 20px 22px 22px; margin: 14px 0; }
	.bh {
		display: flex; align-items: baseline; justify-content: space-between;
		gap: 14px; margin-bottom: 14px; flex-wrap: wrap;
	}
	.bh h3 { margin: 0; font-size: 1.16rem; }
	/* likewise scoped to index.astro; restated so the label matches the others */
	.legend {
		display: inline-flex; align-items: center; gap: 7px;
		font-family: var(--font-mono), monospace; font-size: 0.74rem; color: var(--fg-mute);
	}
	/**
	 * Hairlines are drawn by the cells, not by a gap over a coloured backing.
	 * The gap trick needs an outer border to cover itself: four 1fr columns do
	 * not divide evenly, and the rounding leaves the backing colour showing as a
	 * stray line down the outside edge. The stat row above gets away with it
	 * because it has a border; inside a panel, a second border is one too many.
	 */
	.grid {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		border-radius: 8px; overflow: hidden;
	}
	.cell { border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
	.cell:nth-child(4n + 1) { border-left: 0; }
	.cell:nth-child(-n + 4) { border-top: 0; }
	.cell {
		background: var(--bg-panel-solid); padding: 11px 13px 12px;
		display: flex; flex-direction: column; gap: 3px; min-width: 0;
	}
	/* a flagged move earns a mark on the edge, not a repainted cell */
	.cell.hot { box-shadow: inset 2px 0 0 var(--accent); }
	.label { font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-mute); font-style: normal; }
	b { font-size: 1.04rem; font-weight: 600; letter-spacing: -0.01em; }
	em { font-style: normal; font-size: 0.76rem; font-family: var(--font-mono), monospace; color: var(--fg-dim); }
	em.u { color: #26d07c; }
	em.d { color: #f6465d; }
	em.none { color: #4a5160; }
	.flag { margin-left: 5px; color: var(--accent); font-size: 0.7rem; }

	/**
	 * Where the level sits on its range. A figure alone does not say whether
	 * 1.19x is high — the track does, and the ticks are the bands that matter
	 * (the accumulation line, the level that has marked tops).
	 *
	 * The track is always rendered, even with nothing on it, so the cells stay
	 * the same height while three of them wait for a range.
	 */
	.track {
		position: relative; height: 3px; margin-top: 9px;
		background: var(--line); border-radius: 2px; overflow: hidden;
	}
	.fill {
		position: absolute; left: 0; top: 0; bottom: 0;
		background: linear-gradient(90deg, rgba(240, 185, 11, 0.35), var(--accent));
		border-radius: 2px;
	}
	.pin {
		position: absolute; top: -2px; bottom: -2px; width: 2px;
		background: var(--fg); transform: translateX(-1px); border-radius: 1px;
	}
	/* band edges — recessive, they are context and not the reading */
	.mk {
		position: absolute; top: 0; bottom: 0; width: 1px;
		background: var(--bg-panel-solid); opacity: 0.9;
	}
	.fine { margin: 9px 0 0; font-size: 0.74rem; color: var(--fg-mute); }
	@media (max-width: 860px) {
		.grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		/* the row start moves with the column count, so the rules do too */
		.cell:nth-child(n) { border-left: 1px solid var(--line); border-top: 1px solid var(--line); }
		.cell:nth-child(2n + 1) { border-left: 0; }
		.cell:nth-child(-n + 2) { border-top: 0; }
	}
</style>
