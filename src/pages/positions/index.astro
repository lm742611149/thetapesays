---
/**
 * The trade log. The one page here that isn't aggregated from somewhere else,
 * and the one the home page's promise is written against: positions posted
 * before the outcome is known, losers included.
 *
 * Rules come before trades on purpose. A record is only worth reading if the
 * thing being tested was written down first — otherwise every entry is a story
 * told after the fact. Anything not yet checked against the exchange record
 * shows as pending rather than being filled in with a plausible number.
 */
import Base from '../../layouts/Base.astro';
import ReferralSlot from '../../components/ReferralSlot.astro';
import log from '../../data/trades.json';

const { rules, open, closed, verified, since } = log as any;

const closedTrades = closed as any[];
const wins = closedTrades.filter((t) => t.pnlPct > 0);
const losses = closedTrades.filter((t) => t.pnlPct <= 0);
const avg = (xs: number[]) => (xs.length ? xs.reduce((s, x) => s + x, 0) / xs.length : null);
const avgWin = avg(wins.map((t) => t.pnlPct));
const avgLoss = avg(losses.map((t) => t.pnlPct));
const avgHeld = avg(closedTrades.map((t) => t.held));
// A win rate off a handful of trades is noise wearing a percent sign. Say so
// rather than printing a number that invites being quoted.
const ENOUGH = 20;
const thin = closedTrades.length < ENOUGH;

const num = (v: number, d = 2) =>
	v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const pc = (v: number) => `${v >= 0 ? '+' : ''}${v.toFixed(1)}%`;
const day = (s: string | null) => s ?? null;
---

<Base
	title="Positions"
	description="The trade log behind the site: the rules written down first, every open position with its stop, and every closed trade including the losers."
>
	<div class="wrap page">
		{!verified && (
			<div class="draft">
				<b>Draft — not published.</b>
				<span>
					Prices below come from the signal log and have not been reconciled against the
					exchange record yet. Set <code>verified: true</code> in <code>src/data/trades.json</code>
					once they have.
				</span>
			</div>
		)}

		<header class="ph">
			<p class="label">every fill, including the losers</p>
			<h1>Positions</h1>
			<p class="lede">
				Everything else on this site is data anyone can pull. This page is the part that costs
				something to publish: the rules were written down first, the stop is written down at
				entry, and the trades that went against me are here with the ones that didn't.
			</p>
		</header>

		<!-- RULES -->
		<section class="block rules">
			<div class="bh"><h2>The rules, written down first</h2></div>
			<p class="note">
				These are fixed. A record only means something if the thing being tested was decided
				before the outcome — otherwise every entry is a story told afterwards.
			</p>
			<ol>
				{rules.map((r: string) => <li>{r}</li>)}
			</ol>
		</section>

		<!-- OPEN -->
		<section class="block">
			<div class="bh">
				<h2>Open</h2>
				<span class="live"><span class="pulse"></span><span class="label">live</span></span>
			</div>
			<p class="note">
				Posted before the outcome is known. The stop was written at entry and does not move down.
			</p>
			{open.length === 0 ? (
				<p class="none">Nothing open.</p>
			) : (
				<div class="tw">
					<table>
						<thead>
							<tr>
								<th>Position</th>
								<th class="r">Opened</th>
								<th class="r">Entry</th>
								<th class="r">Stop</th>
								<th class="r">Last</th>
								<th class="r">To stop</th>
							</tr>
						</thead>
						<tbody>
							{open.map((t: any) => (
								<tr data-open={t.sym} data-stop={t.stop} data-entry={t.entry ?? ''}>
									<td><b class="mono">{t.sym}</b></td>
									<td class="r mono dim">{day(t.opened) ?? <span class="pend">pending</span>}</td>
									<td class="r mono">{t.entry ? num(t.entry) : <span class="pend">pending</span>}</td>
									<td class="r mono">{num(t.stop)}</td>
									<td class="r mono" data-live={t.sym} data-live-field="price" data-live-fmt="plain">—</td>
									<td class="r mono" data-tostop>—</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)}
			{open.some((t: any) => t.note) && (
				<ul class="notes">
					{open.filter((t: any) => t.note).map((t: any) => (
						<li><b>{t.sym}</b> — {t.note}</li>
					))}
				</ul>
			)}
		</section>

		<!-- CLOSED -->
		<section class="block">
			<div class="bh"><h2>Closed</h2></div>
			<p class="note">
				All of them. A log that only shows the winners is an advertisement.
			</p>
			{closedTrades.length === 0 ? (
				<p class="none">Nothing closed yet.</p>
			) : (
				<div class="tw">
					<table>
						<thead>
							<tr>
								<th>Position</th>
								<th class="r">Held</th>
								<th class="r">Entry</th>
								<th class="r">Stop</th>
								<th class="r">Exit</th>
								<th class="r">Result</th>
							</tr>
						</thead>
						<tbody>
							{closedTrades.map((t: any) => (
								<tr>
									<td>
										<b class="mono">{t.sym}</b>
										<span class="dates">{t.opened} → {t.closed}</span>
									</td>
									<td class="r mono dim">{t.held}d</td>
									<td class="r mono">{num(t.entry)}</td>
									<td class="r mono dim">{num(t.stop)}</td>
									<td class="r mono">{num(t.exit)}</td>
									<td class={`r mono res ${t.pnlPct >= 0 ? 'up' : 'down'}`}>{pc(t.pnlPct)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)}
			{closedTrades.some((t: any) => t.note) && (
				<ul class="notes">
					{closedTrades.filter((t: any) => t.note).map((t: any) => (
						<li><b>{t.sym}</b> — {t.note}</li>
					))}
				</ul>
			)}
		</section>

		<ReferralSlot />

		<!-- RECORD -->
		<section class="block">
			<div class="bh"><h2>The record so far</h2></div>
			<div class="stats">
				<div class="st"><i class="label">Closed</i><b>{closedTrades.length}</b></div>
				<div class="st"><i class="label">Open</i><b>{open.length}</b></div>
				<div class="st">
					<i class="label">Avg winner</i>
					<b class={avgWin != null ? 'up' : 'dim'}>{avgWin != null ? pc(avgWin) : '—'}</b>
				</div>
				<div class="st">
					<i class="label">Avg loser</i>
					<b class={avgLoss != null ? 'down' : 'dim'}>{avgLoss != null ? pc(avgLoss) : '—'}</b>
				</div>
				<div class="st">
					<i class="label">Avg hold</i>
					<b>{avgHeld != null ? `${avgHeld.toFixed(0)}d` : '—'}</b>
				</div>
				<div class="st"><i class="label">Logging since</i><b>{since}</b></div>
			</div>
			{thin && (
				<p class="thin">
					<b>No win rate yet.</b> {closedTrades.length} closed {closedTrades.length === 1 ? 'trade' : 'trades'} is
					not a sample — a percentage off it would be noise wearing a percent sign. This fills in
					at {ENOUGH}, and the number that appears then will be whatever the log says.
				</p>
			)}
		</section>

		<section class="method">
			<h3>Why this page exists</h3>
			<p>
				A track record published after the fact is worth nothing: the trades that fit the story
				survive and the rest quietly don't get mentioned. The only version worth reading is one
				where the rule was fixed in advance, the stop was written at entry, and the entries go
				up whether or not they work. That is expensive to maintain and easy to check, which is
				the point — everything above can be verified against exchange data on the dates shown.
			</p>
		</section>
	</div>
</Base>

<style>
	.page { padding: 52px 0 0; }
	.ph { max-width: 64ch; margin-bottom: 28px; }
	.ph h1 { margin: 10px 0 14px; }
	.lede { color: var(--fg-dim); margin: 0; }

	.draft {
		display: flex; flex-wrap: wrap; gap: 4px 9px; align-items: baseline;
		margin-bottom: 26px; padding: 13px 16px;
		border: 1px dashed var(--accent); border-radius: var(--radius);
		background: var(--accent-dim);
		font-size: 0.82rem; line-height: 1.6;
	}
	.draft b { color: var(--accent); }
	.draft span { color: var(--fg-dim); }
	.draft code {
		font-family: var(--font-mono), monospace; font-size: 0.78rem;
		color: var(--fg); background: #0a0c10; padding: 1px 5px; border-radius: 4px;
	}

	.block {
		position: relative;
		margin-bottom: 14px;
		background: var(--bg-panel);
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 20px 22px 22px;
	}
	.bh { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
	.bh h2 { margin: 0; font-size: 1.24rem; }
	.live { display: inline-flex; align-items: center; gap: 6px; }
	.note { font-size: 0.85rem; color: var(--fg-mute); margin: 0 0 16px; line-height: 1.6; max-width: 72ch; }
	.none { font-family: var(--font-mono), monospace; font-size: 0.8rem; color: var(--fg-mute); margin: 0; }

	.rules ol {
		margin: 0; padding-left: 0; list-style: none;
		counter-reset: r;
		display: grid; gap: 7px;
	}
	.rules li {
		counter-increment: r;
		display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 11px;
		font-size: 0.89rem; line-height: 1.55; color: var(--fg);
	}
	.rules li::before {
		content: counter(r);
		font-family: var(--font-mono), monospace; font-size: 0.68rem; font-weight: 700;
		color: var(--accent); padding-top: 3px;
	}

	.tw { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
	th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
	th {
		font-family: var(--font-mono), monospace; font-size: 0.62rem; font-weight: 500;
		color: var(--fg-mute); text-transform: uppercase; letter-spacing: 0.08em; text-align: left;
	}
	.r, th.r { text-align: right; }
	tbody tr:last-child td { border-bottom: 0; }
	.mono { font-family: var(--font-mono), monospace; font-variant-numeric: tabular-nums; }
	td b.mono { color: #fff; font-size: 0.92rem; }
	.dim { color: var(--fg-mute); }
	.pend { color: var(--fg-mute); font-size: 0.74rem; font-style: italic; }
	.dates {
		display: block; font-family: var(--font-mono), monospace;
		font-size: 0.64rem; color: var(--fg-mute); margin-top: 2px;
	}
	.res { font-weight: 700; }

	.notes {
		margin: 14px 0 0; padding: 13px 0 0; list-style: none;
		border-top: 1px solid var(--line);
		display: grid; gap: 7px;
	}
	.notes li { font-size: 0.79rem; line-height: 1.6; color: var(--fg-mute); }
	.notes b { color: var(--fg-dim); font-family: var(--font-mono), monospace; }

	.stats {
		display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1px; background: var(--line);
		border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
		margin-top: 12px;
	}
	.st { background: var(--bg-panel); padding: 13px 15px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
	.st i { font-size: 0.6rem; }
	.st b {
		font-family: var(--font-mono), monospace; font-size: 1.14rem; font-weight: 700;
		color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums;
	}
	.st b.dim { color: var(--fg-mute); }

	.thin {
		margin: 14px 0 0; font-size: 0.82rem; line-height: 1.65;
		color: var(--fg-mute); max-width: 72ch;
	}
	.thin b { color: var(--fg-dim); }

	.method {
		margin-top: 14px; padding: 20px 22px;
		border: 1px dashed var(--line-bright); border-radius: var(--radius);
	}
	.method h3 { margin: 0 0 10px; font-size: 1rem; }
	.method p { margin: 0; font-size: 0.87rem; color: var(--fg-dim); line-height: 1.7; max-width: 76ch; }

	@media (max-width: 900px) {
		.stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (max-width: 520px) {
		.stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>

<script>
	/**
	 * Distance to the written stop, off the live tape. It is the only number on
	 * this page that moves, and the only one that matters while a trade is open.
	 */
	for (const row of document.querySelectorAll<HTMLElement>('[data-open]')) {
		const stop = Number(row.dataset.stop);
		const cell = row.querySelector<HTMLElement>('[data-tostop]');
		if (!cell || !Number.isFinite(stop)) continue;

		const paint = (price?: number) => {
			if (!Number.isFinite(price!) || !price) return;
			const room = (price - stop) / price;
			cell.textContent = `${room >= 0 ? '+' : ''}${(room * 100).toFixed(1)}%`;
			cell.className = `r mono res ${room >= 0 ? 'up' : 'down'}`;
		};

		const live = (window as any).__live;
		paint(live?.get(row.dataset.open!)?.price);
		live?.subscribe?.((sym: string) => {
			if (sym === row.dataset.open) paint(live.get(sym)?.price);
		});
	}
</script>
