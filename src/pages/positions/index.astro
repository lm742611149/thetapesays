---
/**
 * The trade log. The one page here that isn't aggregated from somewhere else,
 * and the one the home page's promise is written against.
 *
 * Every number comes from an exchange export via scripts/import-trades.mjs —
 * fills and fees as they actually settled, not what the signal log said to do.
 * Reconciling the two is exactly what this page is for: the hand-kept version
 * had a winning ETH trade recorded as a loss and showed a position that had
 * already been closed.
 */
import Base from '../../layouts/Base.astro';
import ReferralSlot from '../../components/ReferralSlot.astro';
import EquityCurve from '../../components/EquityCurve.astro';
import OpenPositions from '../../components/OpenPositions.astro';
import log from '../../data/trades.json';
import ShareLines from '../../components/ShareLines.astro';
import dca from '../../data/dca.json';

const { rules, open, closed, curve, stats, verified, source, since, through } = log as any;

const money = (v: number, d = 2) => `${v >= 0 ? '+' : '−'}$${Math.abs(v).toFixed(d)}`;
const pc = (v: number) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(2)}%`;
const num = (v: number, d = 2) =>
	v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const px = (v: number) => (v >= 1 ? num(v, 2) : num(v, 4));

// A win rate off a handful of trades is noise wearing a percent sign.
const ENOUGH = 20;
const thin = closed.length < ENOUGH;

const bySym = [...new Set(closed.map((t: any) => t.sym))]
	.map((sym) => {
		const ts = closed.filter((t: any) => t.sym === sym);
		return {
			sym,
			n: ts.length,
			pnl: ts.reduce((s: number, t: any) => s + t.pnl, 0),
			wins: ts.filter((t: any) => t.pnl > 0).length,
		};
	})
	.sort((a, b) => b.pnl - a.pnl);
---

<Base
	image="/og/positions.png"
	title="Positions"
	description={`Every closed trade from the exchange record — ${stats.trades} trades, ${stats.winRate}% win rate, ${money(stats.netPnl)} net. Rules written down first, losers included.`}
	noindex={!verified}
	keywords={[
		'crypto trading track record', 'public trade log', 'verified trading results',
		'spot trading system', 'trading rules', 'profit factor', 'max drawdown',
	]}
	schema={{
		'@type': 'Dataset',
		name: 'The Tape Says — published trade log',
		description: `Every closed spot trade from the exchange record: ${stats.trades} trades between ${since} and ${through}, ${stats.winRate}% win rate, ${money(stats.netPnl)} net after fees.`,
		creator: { '@id': 'https://thetapesays.com/#person' },
		isAccessibleForFree: true,
		temporalCoverage: `${since}/${through}`,
		variableMeasured: ['entry price', 'exit price', 'holding period', 'realised P&L', 'fees'],
	}}
>
	<div class="wrap page">
		{!verified && (
			<div class="draft">
				<b>Draft — not published.</b>
				<span>Prices have not been reconciled against the exchange record yet.</span>
			</div>
		)}

		<header class="ph">
			<p class="label">every fill, including the losers</p>
			<h1>Positions</h1>
			<p class="lede">
				Everything else on this site is data anyone can pull. This is the part that costs
				something to publish. Read straight off the exchange export — the fills that happened,
				the fees they cost, and the ones that lost.
			</p>
		</header>

		<!-- HEADLINE -->
		<section class="block">
			<div class="topline">
				<div class="hero">
					<i class="label">Net realised · {since} → {through}</i>
					<b class={stats.netPnl >= 0 ? 'up' : 'down'}>{money(stats.netPnl)}</b>
					<span class="unit">after ${stats.fees.toFixed(2)} in fees</span>
				</div>
				<dl class="kpi">
					<div><dt>Trades</dt><dd>{stats.trades}</dd></div>
					<div><dt>Win rate</dt><dd>{stats.winRate}%<em>{stats.wins}W / {stats.losses}L</em></dd></div>
					<div><dt>Profit factor</dt><dd>{stats.profitFactor}<em>won per $1 lost</em></dd></div>
					<div>
						<dt>Max drawdown</dt>
						<dd class="down">{money(stats.drawdown.abs)}<em>{Math.abs(stats.drawdown.pct)}% off peak</em></dd>
					</div>
				</dl>
			</div>
		</section>

		<!-- CURVE -->
		<section class="block">
			<div class="bh">
				<h2>What the account did</h2>
				<span class="legend">cumulative · {stats.trades} closed trades</span>
			</div>
			<p class="note">
				Realised P&amp;L, banked at each close. The bars underneath are the individual trades on
				the same axis — one of them is most of everything above it.
			</p>
			<EquityCurve curve={curve} drawdown={stats.drawdown} />
		</section>

		<!-- SHAPE -->
		<section class="block">
			<div class="bh"><h2>The shape of it</h2></div>
			<div class="stats">
				<div class="st"><i class="label">Avg winner</i><b class="up">{pc(stats.avgWin)}</b></div>
				<div class="st"><i class="label">Avg loser</i><b class="down">{pc(stats.avgLoss)}</b></div>
				<div class="st"><i class="label">Best</i><b class="up">{pc(stats.best)}</b></div>
				<div class="st"><i class="label">Worst</i><b class="down">{pc(stats.worst)}</b></div>
				<div class="st"><i class="label">Avg hold</i><b>{stats.avgHeld}d</b></div>
				<div class="st"><i class="label">Avg size</i><b>${stats.avgSize}</b></div>
			</div>
			<p class="thin">
				The win rate is not what makes this work — a <b>{pc(stats.avgWin)}</b> average winner
				against a <b>{pc(stats.avgLoss)}</b> average loser is. Losers get cut at a few percent;
				winners are left alone. That asymmetry is the whole system.
				{thin && (
					<>
						{' '}And the caveat that belongs next to all of it: <b>{stats.trades} trades is not a
						sample.</b> Every figure on this page will move before {ENOUGH}, and wherever it
						settles is what gets printed.
					</>
				)}
			</p>
		</section>

		<ReferralSlot />

		<!-- RULES -->
		<section class="block rules">
			<div class="bh"><h2>The rules, written down first</h2></div>
			<p class="note">
				Fixed in advance. A record only means something if what was being tested was decided
				before the outcome — otherwise every entry is a story told afterwards.
			</p>
			<ol>
				{rules.map((r: string) => <li>{r}</li>)}
			</ol>
		</section>

		<!-- OPEN -->
		<section class="block">
			<div class="bh">
				<h2>Where the book is now</h2>
				<span class="live"><span class="pulse"></span><span class="legend">live</span></span>
			</div>
			<p class="note">
				One tab per instrument. Open positions price off the tape; a flat tab shows what that
				instrument last did and what it has paid overall.
			</p>
			<OpenPositions />
		</section>

		<!-- CLOSED -->
		<section class="block">
			<div class="bh">
				<h2>Every closed trade</h2>
				<span class="legend">{source}</span>
			</div>
			<p class="note">All of them. A log that only shows the winners is an advertisement.</p>
			<div class="tw">
				<table>
					<thead>
						<tr>
							<th>Position</th>
							<th class="r">Held</th>
							<th class="r hide-s">Entry</th>
							<th class="r hide-s">Exit</th>
							<th class="r hide-s">Size</th>
							<th class="r">P&amp;L</th>
							<th class="r">Return</th>
						</tr>
					</thead>
					<tbody>
						{[...closed].reverse().map((t: any) => (
							<tr>
								<td>
									<b class="mono">{t.sym}</b>
									<span class="dates">{t.opened} → {t.closed}</span>
								</td>
								<td class="r mono dim">{t.held}d</td>
								<td class="r mono hide-s">{px(t.entry)}</td>
								<td class="r mono hide-s">{px(t.exit)}</td>
								<td class="r mono dim hide-s">${num(t.size, 0)}</td>
								<td class={`r mono res ${t.pnl >= 0 ? 'up' : 'down'}`}>{money(t.pnl)}</td>
								<td class={`r mono res ${t.pnlPct >= 0 ? 'up' : 'down'}`}>{pc(t.pnlPct)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<div class="bysym">
				{bySym.map((s: any) => (
					<div class="sy">
						<i class="label">{s.sym}</i>
						<b class={s.pnl >= 0 ? 'up' : 'down'}>{money(s.pnl)}</b>
						<span>{s.wins}/{s.n} won</span>
					</div>
				))}
			</div>
		</section>

		<section class="block dca">
			<div class="bh">
				<h2>The other account: six months of buying</h2>
				<span class="legend">{(dca as any).buys} fills · not a trading system</span>
			</div>
			<p class="note">
				This is dollar-cost averaging, and it is kept apart from the trades above on purpose.
				There is no entry rule, no stop and no exit — the rule is "buy on schedule", so win rate
				and profit factor mean nothing here and mixing the two records would make both of them
				lies. What it can be measured against is the alternative: the same money, the same split,
				bought on day one.
			</p>

			<div class="dstats">
				<div><i>Invested</i><b>${num((dca as any).invested)}</b><em>{(dca as any).buys} buys, six coins</em></div>
				<div><i>Worth now</i><b class="up">${num((dca as any).value)}</b><em>{pc((dca as any).ret)}</em></div>
				<div><i>Bought on day one</i><b>${num((dca as any).lumpValue)}</b><em>{pc((dca as any).lumpRet)}</em></div>
				<div><i>Difference</i><b class="up">{pc((dca as any).edge).replace('%', 'pp')}</b><em>in favour of buying through</em></div>
			</div>

			<ShareLines
				series={[
					{ name: 'Weekly', points: (dca as any).curve.map((p: any) => ({ t: p.t, v: p.dca })), color: '#f0b90b' },
					{ name: 'Day one', points: (dca as any).curve.map((p: any) => ({ t: p.t, v: p.lump })), color: '#7c8698' },
				]}
				height={190}
				label="weekly buying versus buying it all on day one"
			/>

			<div class="tbl-wrap">
				<table class="dtbl">
					<thead>
						<tr><th>Coin</th><th class="r">Buys</th><th class="r">Invested</th><th class="r">Average</th><th class="r">Now</th><th class="r">Return</th></tr>
					</thead>
					<tbody>
						{(dca as any).perSym.map((c: any) => (
							<tr>
								<td>{c.sym}</td>
								<td class="r mono">{c.buys}</td>
								<td class="r mono">${num(c.invested)}</td>
								<td class="r mono">{px(c.avg)}</td>
								<td class="r mono">{px(c.spot)}</td>
								<td class={`r mono ${c.ret >= 0 ? 'up' : 'down'}`}>{pc(c.ret, 1)}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<p class="fine">
				Two things this does not prove. The money was only at work {(dca as any).weightedDays} of
				{' '}{(dca as any).spanDays} days — half the capital sat in cash, which is the cost of
				buying in instalments and it is already inside the number above. And the edge comes from
				the drawdown: the market fell 33% in the middle of this window, which is exactly when
				buying on schedule collects its cheapest units. Run the same comparison across a window
				that only goes up and day one wins. The method is not better than the alternative; it was
				better on this path.
			</p>
		</section>

		<section class="method">
			<h3>How to check this</h3>
			<p>
				Every row is a spot fill with a date and a price. Pull the daily bars for that pair on
				those dates and both prices have to sit inside the day's range — if one doesn't, the row
				is wrong and I want to hear about it. Fees are the exchange's own, already deducted from
				the P&amp;L shown. Nothing here is modelled, backfilled or restated: the file this page
				reads is regenerated from the export rather than edited by hand.
			</p>
			<p>
				A track record published after the fact is worth nothing — the trades that fit the story
				survive and the rest quietly go unmentioned. That is why the rules sit above the trades,
				and why the {stats.losses} losers are in the same table as the winners.
			</p>
		</section>
	</div>
</Base>

<style>
	.page { padding-top: 52px; }
	.ph { max-width: 64ch; margin-bottom: 28px; }
	.ph h1 { margin: 10px 0 14px; }
	.lede { color: var(--fg-dim); margin: 0; }

	.draft {
		display: flex; flex-wrap: wrap; gap: 4px 9px; align-items: baseline;
		margin-bottom: 26px; padding: 13px 16px;
		border: 1px dashed var(--accent); border-radius: var(--radius);
		background: var(--accent-dim); font-size: 0.82rem; line-height: 1.6;
	}
	.draft b { color: var(--accent); }
	.draft span { color: var(--fg-dim); }

	.block {
		position: relative; margin-bottom: 14px;
		background: var(--bg-panel); border: 1px solid var(--line);
		border-radius: var(--radius); padding: 20px 22px 22px;
	}
	.bh {
		display: flex; align-items: center; justify-content: space-between;
		gap: 12px; margin-bottom: 6px; flex-wrap: wrap;
	}
	.bh h2 { margin: 0; font-size: 1.24rem; }
	.legend { font-family: var(--font-mono), monospace; font-size: 0.66rem; color: var(--fg-mute); }
	.live { display: inline-flex; align-items: center; gap: 6px; }
	.note { font-size: 0.85rem; color: var(--fg-mute); margin: 0 0 16px; line-height: 1.6; max-width: 74ch; }

	.topline { display: flex; align-items: flex-end; justify-content: space-between; gap: 26px; flex-wrap: wrap; }
	.hero { display: flex; flex-direction: column; gap: 3px; }
	.hero i { font-size: 0.62rem; }
	.hero b {
		font-family: var(--font-mono), monospace; font-size: 2.6rem; font-weight: 700;
		line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
	}
	.hero .unit { font-family: var(--font-mono), monospace; font-size: 0.66rem; color: var(--fg-mute); }

	.kpi { display: flex; gap: 28px; margin: 0; flex-wrap: wrap; }
	.kpi div { display: flex; flex-direction: column; gap: 3px; }
	.kpi dt {
		font-family: var(--font-mono), monospace; font-size: 0.6rem; color: var(--fg-mute);
		text-transform: uppercase; letter-spacing: 0.09em;
	}
	.kpi dd {
		margin: 0; font-family: var(--font-mono), monospace; font-size: 1.28rem; font-weight: 700;
		color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums;
	}
	.kpi em {
		display: block; font-style: normal; font-size: 0.6rem; font-weight: 500;
		color: var(--fg-mute); margin-top: 3px; letter-spacing: 0.04em;
	}

	.stats {
		display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1px;
		background: var(--line); border: 1px solid var(--line);
		border-radius: var(--radius); overflow: hidden; margin-top: 12px;
	}
	.st { background: var(--bg-panel); padding: 13px 15px; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
	.st i { font-size: 0.6rem; }
	.st b {
		font-family: var(--font-mono), monospace; font-size: 1.14rem; font-weight: 700;
		color: #fff; line-height: 1.1; font-variant-numeric: tabular-nums;
	}
	.thin { margin: 14px 0 0; font-size: 0.83rem; line-height: 1.7; color: var(--fg-mute); max-width: 76ch; }
	.thin b { color: var(--fg-dim); }

	.rules ol { margin: 0; padding-left: 0; list-style: none; counter-reset: r; display: grid; gap: 7px; }
	.rules li {
		counter-increment: r; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 11px;
		font-size: 0.89rem; line-height: 1.55; color: var(--fg);
	}
	.rules li::before {
		content: counter(r); font-family: var(--font-mono), monospace;
		font-size: 0.68rem; font-weight: 700; color: var(--accent); padding-top: 3px;
	}

	.tw { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
	th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
	th {
		font-family: var(--font-mono), monospace; font-size: 0.62rem; font-weight: 500;
		color: var(--fg-mute); text-transform: uppercase; letter-spacing: 0.08em; text-align: left;
	}
	.r, th.r { text-align: right; }
	tbody tr:last-child td { border-bottom: 0; }
	.mono { font-family: var(--font-mono), monospace; font-variant-numeric: tabular-nums; }
	td b.mono { color: #fff; font-size: 0.92rem; }
	.dim { color: var(--fg-mute); }
	.dates { display: block; font-family: var(--font-mono), monospace; font-size: 0.64rem; color: var(--fg-mute); margin-top: 2px; }
	.res { font-weight: 700; }

	.bysym {
		display: flex; gap: 10px; flex-wrap: wrap;
		margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--line);
	}
	.sy {
		display: flex; flex-direction: column; gap: 2px;
		padding: 9px 14px; border: 1px solid var(--line); border-radius: 8px; background: #0a0c10;
	}
	.sy i { font-size: 0.58rem; }
	.sy b { font-family: var(--font-mono), monospace; font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
	.sy span { font-family: var(--font-mono), monospace; font-size: 0.6rem; color: var(--fg-mute); }

	/* the DCA block is visually a sibling of the trade sections but must never
	   read as part of the same record — the note says so, the stat row is laid
	   out differently from the trade stats so the eye agrees */
	.dca .note { margin: 0 0 18px; font-size: 0.88rem; line-height: 1.65; color: var(--fg-dim); max-width: 76ch; }
	.dstats {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px; background: var(--line); border-radius: 10px; overflow: hidden; margin-bottom: 20px;
	}
	.dstats > div {
		background: var(--bg-panel-solid); padding: 13px 15px 14px;
		display: flex; flex-direction: column; gap: 4px;
	}
	.dstats i {
		font-style: normal; font-size: 0.68rem; letter-spacing: 0.06em;
		text-transform: uppercase; color: var(--fg-mute);
	}
	.dstats b { font-family: var(--font-mono), monospace; font-size: 1.24rem; font-weight: 600; }
	.dstats em { font-style: normal; font-size: 0.74rem; color: var(--fg-mute); }
	.dtbl { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 0.86rem; }
	.dtbl th, .dtbl td { padding: 8px 10px; border-bottom: 1px solid var(--line); text-align: left; }
	.dtbl th {
		font-family: var(--font-mono), monospace; font-size: 0.68rem; letter-spacing: 0.06em;
		text-transform: uppercase; color: var(--fg-mute); font-weight: 500;
	}
	.dtbl .r { text-align: right; }
	.dca .fine { margin: 16px 0 0; font-size: 0.8rem; line-height: 1.65; color: var(--fg-mute); max-width: 82ch; }
	@media (max-width: 720px) { .dstats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

	.method { margin-top: 14px; padding: 20px 22px; border: 1px dashed var(--line-bright); border-radius: var(--radius); }
	.method h3 { margin: 0 0 10px; font-size: 1rem; }
	.method p { margin: 0 0 12px; font-size: 0.87rem; color: var(--fg-dim); line-height: 1.7; max-width: 78ch; }
	.method p:last-child { margin-bottom: 0; }

	@media (max-width: 900px) {
		.stats { grid-template-columns: repeat(3, minmax(0, 1fr)); }
		.kpi { gap: 20px; }
	}
	@media (max-width: 620px) {
		.hide-s { display: none; }
		.hero b { font-size: 2.1rem; }
		th, td { padding: 9px 9px; }
	}
	@media (max-width: 520px) {
		.stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
</style>

<script>
	/** Unrealised P&L on anything still open, off the live tape. */
	for (const row of document.querySelectorAll<HTMLElement>('[data-open]')) {
		const entry = Number(row.dataset.entry);
		const qty = Number(row.dataset.qty);
		const cell = row.querySelector<HTMLElement>('[data-unreal]');
		if (!cell || !Number.isFinite(entry)) continue;

		const paint = (price?: number) => {
			if (!price || !Number.isFinite(price)) return;
			const pnl = (price - entry) * qty;
			const pct = (price / entry - 1) * 100;
			cell.textContent =
				`${pnl >= 0 ? '+' : '−'}$${Math.abs(pnl).toFixed(2)} (${pct >= 0 ? '+' : '−'}${Math.abs(pct).toFixed(2)}%)`;
			cell.className = `r mono res ${pnl >= 0 ? 'up' : 'down'}`;
		};
		const live = (window as any).__live;
		paint(live?.get(row.dataset.open!)?.price);
		live?.subscribe?.((sym: string) => {
			if (sym === row.dataset.open) paint(live.get(sym)?.price);
		});
	}
</script>
